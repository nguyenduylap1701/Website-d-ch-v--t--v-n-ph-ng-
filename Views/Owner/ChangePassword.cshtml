@model TroTot.Web.ViewModels.OwnerPasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Active"] = "profile";
    ViewData["DashboardLayout"] = true;
}
<main class="admin-management">
  <header class="admin-management-heading"><div><span class="admin-kicker">BẢO MẬT TÀI KHOẢN</span><h1>Đổi mật khẩu</h1><p>Chọn mật khẩu mới có ít nhất 8 ký tự.</p></div></header>
  <section class="admin-data-card owner-form-card">
    <form asp-action="ChangePassword" method="post" class="owner-form">
      @Html.AntiForgeryToken()
      <label>Mật khẩu hiện tại<input asp-for="CurrentPassword" autocomplete="current-password" /><span asp-validation-for="CurrentPassword"></span></label>
      <label>Mật khẩu mới<input asp-for="NewPassword" autocomplete="new-password" /><span asp-validation-for="NewPassword"></span></label>
      <label>Nhập lại mật khẩu mới<input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword"></span></label>
      <div class="owner-form-actions"><button class="admin-action-button primary" type="submit">Cập nhật mật khẩu</button></div>
    </form>
  </section>
</main>
