@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Microsoft.Extensions.Configuration.IConfiguration AppConfiguration
@model TroTot.Web.Models.Room
@using System.Globalization
@using TroTot.Web.Models
@{
    ViewData["Title"] = Model.Title + " | TroTot.vn";
    ViewData["Description"] = Model.Description ?? "Chi tiết phòng trọ";
    ViewData["Icon"] = "🏠";
    ViewData["Active"] = "rooms";
    ViewData["NavScrolled"] = false;
    var imageList = Model.Images.Any() ? Model.Images.Select(i => i.Path).ToList() : new List<string> { "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80" };
    var amenities = Model.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var relatedRooms = ViewBag.RelatedRooms as IEnumerable<TroTot.Web.Models.Room> ?? Enumerable.Empty<TroTot.Web.Models.Room>();
    var reviews = ViewBag.RoomReviews as IEnumerable<TroTot.Web.Models.RoomReview> ?? Enumerable.Empty<TroTot.Web.Models.RoomReview>();
    var primaryImage = imageList.First();
    var mockConfirmationEnabled = bool.TryParse(AppConfiguration["VnPay:EnableMockConfirmation"], out var mockEnabled) && mockEnabled;
    var allowMockDeposit = HostEnvironment.IsDevelopment() && mockConfirmationEnabled;
}

<section class="room-detail-hero">
  <div class="container">
    <div class="crumbs">
      <a href="/">Trang chủ</a>
      <span>›</span>
      <a href="/rooms">Tìm phòng</a>
      <span>›</span>
      <span>@Model.District</span>
    </div>
    <div class="detail-header-row">
      <div>
        <span class="detail-badge">@(Model.IsVerified ? "✓ Đã xác minh" : "Hot")</span>
        <h1 class="detail-title">@Model.Title</h1>
      </div>
      <div class="detail-price">@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", Model.Price) <span>/tháng</span></div>
    </div>
  </div>
</section>

<main class="room-detail-main">
  <div class="container">
    <div class="detail-layout">
      <div class="detail-content">
        <div class="gallery-grid">
          <div class="gallery-main">
            <img src="@primaryImage" alt="@Model.Title" />
          </div>
          <div class="gallery-side">
            @for (var i = 1; i < Math.Min(imageList.Count, 4); i++)
            {
              <img src="@imageList[i]" alt="@Model.Title" />
            }
          </div>
        </div>

        <div class="detail-card">
          <h2>Thông tin phòng</h2>
          <div class="detail-meta-grid">
            <div><span>Quận</span><strong>@Model.District</strong></div>
            <div><span>Diện tích</span><strong>@Model.Area m²</strong></div>
            <div><span>Loại phòng</span><strong>@(Model.RoomType == "single" ? "Phòng đơn" : Model.RoomType == "shared" ? "Ở ghép" : "Căn hộ mini")</strong></div>
            <div><span>Địa chỉ</span><strong>@Model.Address</strong></div>
          </div>
        </div>

        <div class="detail-card">
          <h2>Mô tả</h2>
          <p>@(Model.Description ?? "Phòng trọ sạch sẽ, tiện nghi đầy đủ, phù hợp cho sinh viên và người đi làm.")</p>
        </div>

        <div class="detail-card">
          <h2>Tiện nghi</h2>
          <div class="amenity-list">
            @foreach (var item in amenities)
            {
              <span class="amenity-pill">@item</span>
            }
          </div>
        </div>

        <div class="detail-card">
          <h2>Nội quy</h2>
          <ul class="rules-list">
            @if (!string.IsNullOrWhiteSpace(Model.Rules))
            {
                foreach (var rule in Model.Rules.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    <li>@rule</li>
                }
            }
            else
            {
                <li>Giữ vệ sinh chung.</li>
                <li>Không hút thuốc trong phòng.</li>
                <li>Giữ đồng phục và nhắc nhở các quy định nội khu.</li>
            }
          </ul>
        </div>
      </div>

      <aside class="detail-sidebar">
        <div class="booking-card" id="booking">
          <div class="booking-header">
            <span>Đặt lịch xem phòng</span>
            <strong>@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", Model.Price)</strong>
          </div>

          <form asp-controller="Home" asp-action="DatLichXem" method="post" class="booking-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="RoomName" value="@Model.Title" />
            <input type="hidden" name="returnUrl" value="/phong/@Model.Id" />
            <div class="form-group">
              <label>Họ tên</label>
              <input type="text" name="Name" required placeholder="Nhập họ tên" class="form-input" />
            </div>
            <div class="form-group">
              <label>Số điện thoại</label>
              <input type="tel" name="Phone" required placeholder="0901234567" class="form-input" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Ngày</label>
                <input type="date" name="Date" required class="form-input" />
              </div>
              <div class="form-group">
                <label>Giờ</label>
                <input type="time" name="Time" required class="form-input" />
              </div>
            </div>
            <div class="form-group">
              <label>Ghi chú</label>
              <textarea name="Note" rows="3" class="form-input" placeholder="Bạn muốn xem vào khung giờ nào?"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full">Đặt lịch xem ngay</button>
          </form>
        </div>

                <div class="summary-card">
          <h3>Chi phí gần gũi</h3>
          <ul>
            <li><span>Điện</span><strong>@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ" , Model.ElectricPrice)/kWh</strong></li>
            <li><span>Nước</span><strong>@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ" , Model.WaterPrice)/người</strong></li>
            <li><span>Internet</span><strong>@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ" , Model.InternetFee)</strong></li>
            <li><span>Đặt cọc</span><strong>@Model.DepositMonths tháng</strong></li>
          </ul>
        </div>

        @if (Model.AvailabilityStatus == RoomAvailability.Available)
        {
            <div class="summary-card deposit-section">
                <h3>Giữ chỗ nhanh</h3>
                <p style="font-size: 0.85rem; margin-bottom: 12px; color: var(--muted);">Đặt cọc trực tuyến 500,000đ để giữ phòng ngay trong 24h.</p>
                <button type="button" id="btn-deposit" class="btn-primary w-full" onclick="handleDeposit(@Model.Id)">
                    Đặt cọc giữ chỗ
                </button>
                @if (allowMockDeposit)
                {
                    <div id="mock-deposit-panel" hidden style="margin-top: 16px; padding: 14px; border: 1px dashed #d97706; border-radius: 12px;">
                        <p style="margin: 0 0 10px; color: #92400e;"><strong>Demo:</strong> Nút này mô phỏng thanh toán thành công, không xác minh tiền đã chuyển.</p>
                        <form id="mock-deposit-form" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-secondary w-full">Xác nhận thành công (mô phỏng)</button>
                        </form>
                    </div>
                }
            </div>
        }
        else if (Model.AvailabilityStatus == RoomAvailability.PendingDeposit)
        {
            <div class="summary-card deposit-section">
                <p style="color: #d97706; font-weight: bold; text-align: center;">⚠️ Phòng đang có người đặt chỗ...</p>
            </div>
        }
        else if (Model.AvailabilityStatus == RoomAvailability.Rented)
        {
            <div class="summary-card deposit-section">
                <p style="color: #ef4444; font-weight: bold; text-align: center;">🚫 Phòng đã được thuê</p>
            </div>
        }
      </aside>

    </div>

    <section class="detail-card room-reviews" id="reviews">
      <div class="room-reviews-heading">
        <div><h2>Đánh giá phòng</h2><p>Chia sẻ trải nghiệm thực tế của bạn</p></div>
        <div class="room-review-summary">
          <strong title="Điểm trung bình trên 5 sao">@(reviews.Any() ? ((double)ViewBag.RoomAverageRating).ToString("0.0") : "–")/5 <span aria-hidden="true">★</span></strong>
          <span class="room-review-count">@reviews.Count() đánh giá</span>
        </div>
      </div>
      @if (reviews.Any())
      {
        <div class="room-review-list">
          @foreach (var review in reviews)
          {
            <article class="room-review-item">
              <div class="room-review-meta">
                <strong>@(review.User?.FullName ?? "Người thuê")</strong>
                <span class="admin-rating" aria-label="@review.Rating trên 5 sao">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                <time datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</time>
              </div>
              <p>@review.Content</p>
              @if (!string.IsNullOrWhiteSpace(review.ImagePath))
              {
                <a class="room-review-image-link" href="@review.ImagePath" target="_blank" rel="noopener noreferrer">
                  <img class="room-review-image" src="@review.ImagePath" alt="Ảnh đính kèm đánh giá" loading="lazy" />
                </a>
              }
            </article>
          }
        </div>
      }
      else
      {
        <p class="room-review-empty">Chưa có đánh giá được duyệt cho phòng này.</p>
      }

      @if (User.Identity?.IsAuthenticated == true)
      {
        <form method="post" action="/phong/@Model.Id/danh-gia" enctype="multipart/form-data" class="room-review-form" id="room-review-form-mvc">
          @Html.AntiForgeryToken()
          <h3>Viết đánh giá</h3>
          <p style="font-size: 0.9rem; color: var(--muted); margin-bottom: 10px;">
              <i class="fas fa-info-circle"></i> Chỉ người đã có hợp đồng thuê phòng này mới có thể đánh giá.
          </p>
          <fieldset class="room-review-rating">
            <legend>Số sao</legend>
            @for (var rating = 1; rating <= 5; rating++)
            {
              <input id="review-rating-@rating" type="radio" name="rating" value="@rating" required />
              <label for="review-rating-@rating" title="@rating sao">★</label>
            }
          </fieldset>
          <label for="review-content">Nội dung</label>
          <textarea id="review-content" name="content" rows="4" maxlength="2000" required placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
          @* <label for="review-image">Ảnh đính kèm (không bắt buộc)</label>
          <input id="review-image" name="image" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" /> *@
          <button type="submit" class="btn-primary">Gửi đánh giá</button>
          <small>Đánh giá sẽ được hiển thị ngay lập tức sau khi gửi.</small>
        </form>
      }
      else
      {
        <p class="room-review-login">
          <a href="/dang-nhap?returnUrl=%2Fphong%2F@(Model.Id)%23reviews">Đăng nhập</a>
          hoặc <a href="/dang-ky">tạo tài khoản</a> để gửi đánh giá.
        </p>
      }
    </section>

    @if (relatedRooms.Any())
    {
      <section class="related-section">
        <div class="section-header left">
          <div class="section-tag">Phòng tương tự</div>
          <h2 class="section-title">Có thể bạn thích</h2>
        </div>
        <div class="rooms-grid-compact">
          @foreach (var room in relatedRooms)
          {
             var roomImage = room.Images.FirstOrDefault()?.Path ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80";
             <article class="compact-room-card">
               <img src="@roomImage" alt="@room.Title" />
               <div class="compact-room-content">
                 <div class="compact-room-head">
                   <h3>@room.Title</h3>
                   <strong>@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", room.Price)</strong>
                 </div>
                 <div class="compact-room-meta">📍 @room.District • @room.Area m²</div>
                 <a href="/phong/@room.Id" class="btn-outline-primary">Xem chi tiết</a>
               </div>
             </article>
          }
        </div>
      </section>
    }
  </div>
</main>

@section Scripts {
  <script>
    async function handleDeposit(roomId) {
        if (!confirm('Bạn sẽ được chuyển hướng đến cổng thanh toán VNPay để đặt cọc 500,000đ. Bạn có chắc chắn?')) return;

        const mockEnabled = @allowMockDeposit.ToString().ToLowerInvariant();
        const paymentTab = mockEnabled ? window.open('about:blank', '_blank') : null;
        if (mockEnabled && !paymentTab) {
            alert('Please allow pop-ups so the test payment and demo button can stay open side by side.');
            return;
        }
        const btn = document.getElementById('btn-deposit');
        btn.disabled = true;
        btn.textContent = 'Đang khởi tạo...';

        try {
            const response = await fetch('/Payment/CreateDeposit?roomId=' + roomId, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });

            if (response.redirected) {
                if (paymentTab) paymentTab.close();
                window.location.href = response.url;
                return;
            }

            if (!(response.headers.get('content-type') || '').includes('application/json')) {
                if (paymentTab) paymentTab.close();
                btn.disabled = false;
                btn.textContent = 'Đặt cọc giữ chỗ';
                alert('Phiên đăng nhập trên địa chỉ tunnel chưa hợp lệ. Hãy đăng nhập lại rồi thử thanh toán.');
                return;
            }

            const result = await response.json();
            if (response.ok && result.url) {
                if (paymentTab) {
                    paymentTab.location.href = result.url;
                    const panel = document.getElementById('mock-deposit-panel');
                    const form = document.getElementById('mock-deposit-form');
                    if (panel && form) {
                        form.action = '/Payment/MockConfirm/' + result.depositId;
                        panel.hidden = false;
                    }
                } else {
                    window.location.href = result.url;
                }
            } else {
                if (paymentTab) paymentTab.close();
                btn.disabled = false;
                btn.textContent = 'Đặt cọc giữ chỗ';
                alert(result.message || 'Không thể tạo giao dịch thanh toán. Vui lòng thử lại.');
            }
        } catch (e) {
            if (paymentTab) paymentTab.close();
            btn.disabled = false;
            btn.textContent = 'Đặt cọc giữ chỗ';
            alert('Không thể kết nối đến máy chủ. Vui lòng thử lại.');
        }
    }
  </script>
  @* Script cho AJAX nếu cần, hiện tại dùng Form POST truyền thống cho đơn giản *@
}
