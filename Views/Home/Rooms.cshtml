@model List<TroTot.Web.Models.Room>
@using System.Globalization
@{
    ViewData["Title"] = "Tìm Phòng Trọ – Lọc Nâng Cao | TroTot.vn";
    ViewData["Description"] = "Tìm kiếm và lọc phòng trọ theo khu vực, giá, tiện nghi. Hàng nghìn phòng uy tín tại TP.HCM.";
    ViewData["Icon"] = "🏠";
    ViewData["Active"] = "rooms";
    ViewData["PageClass"] = "rooms-listing-page";
    ViewData["NavScrolled"] = false;
    var keyword = (string?)ViewBag.Keyword ?? "";
    var district = (string?)ViewBag.District ?? "";
    var type = (string?)ViewBag.Type ?? "";
    var amenities = (string[]?)ViewBag.Amenities ?? Array.Empty<string>();
    var priceRange = (string?)ViewBag.PriceRange ?? "";
    var districts = (IEnumerable<string>?)ViewBag.Districts ?? Array.Empty<string>();
    var verifiedOnly = (bool?)ViewBag.VerifiedOnly == true;
    var sort = (string?)ViewBag.Sort ?? "newest";
    var isAdvisorResults = (bool?)ViewBag.IsAdvisorResults == true;
    var advisorPlace = (string?)ViewBag.AdvisorPlace ?? "";
    var advisorDistanceUnverified = (bool?)ViewBag.AdvisorDistanceUnverified == true;
    var advisorRadius = (int?)ViewBag.AdvisorRadiusKm;
    var advisorMinPrice = (long?)ViewBag.MinPrice;
    var advisorMaxPrice = (long?)ViewBag.MaxPrice;
    var advisorTransport = (string?)ViewBag.AdvisorTransport ?? "";
    var advisorElectricityKwh = (int?)ViewBag.AdvisorElectricityKwh;
    var advisorOccupants = (int?)ViewBag.AdvisorOccupants;
    var advisorLatitude = (double?)ViewBag.AdvisorLatitude;
    var advisorLongitude = (double?)ViewBag.AdvisorLongitude;
    var advisorRoomScores = ViewBag.AdvisorRoomScores as Dictionary<int, int> ?? new();
    var advisorRoomDistances = ViewBag.AdvisorRoomDistances as Dictionary<int, double> ?? new();
    var advisorRoomLocations = ViewBag.AdvisorRoomLocations as Dictionary<int, double[]> ?? new();
    var advisorMapMarkers = Model
        .Where(room => advisorRoomLocations.ContainsKey(room.Id))
        .Select(room => new
        {
            title = room.Title,
            coordinates = advisorRoomLocations[room.Id]
        })
        .ToList();
    var priceLabels = new Dictionary<string, string>
    {
        ["under-3m"] = "Dưới 3 triệu",
        ["3-5m"] = "3 đến dưới 5 triệu",
        ["5-8m"] = "5 đến dưới 8 triệu",
        ["over-8m"] = "Từ 8 triệu"
    };
}

@section Styles {
  @if (isAdvisorResults)
  {
    <style>
      .advisor-search-summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 0 0 18px; padding: 20px; border: 1px solid #cfe7e3; border-radius: 16px; background: linear-gradient(120deg, #effaf7, #fff); }
      .advisor-search-summary h2 { margin: 4px 0; color: #183b39; font-size: 1.25rem; }
      .advisor-search-summary p { margin: 0; color: #60716f; }
      .advisor-search-kicker { color: #147d70; font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
      .advisor-search-map { height: 320px; margin: 0 0 5px; border: 1px solid var(--line); border-radius: 14px; z-index: 0; }
      .advisor-search-map-note { margin: 0 0 14px; color: var(--muted); font-size: .75rem; }
      .advisor-room-match { margin: 0 0 10px; color: #147d70; font-size: .85rem; }
      .advisor-room-match strong { font-weight: 800; }
      @@media (max-width: 640px) {
        .advisor-search-summary { align-items: flex-start; flex-direction: column; }
      }
    </style>
  }
  @if (isAdvisorResults && advisorLatitude.HasValue && advisorLongitude.HasValue && advisorMapMarkers.Count > 0)
  {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  }
}

@section Scripts {
  @if (isAdvisorResults && advisorLatitude.HasValue && advisorLongitude.HasValue)
  {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
      (() => {
        const mapElement = document.getElementById('advisor-search-map');
        if (!mapElement || !window.L) return;

        const origin = [
          @advisorLatitude.Value.ToString(CultureInfo.InvariantCulture),
          @advisorLongitude.Value.ToString(CultureInfo.InvariantCulture)
        ];
        const markers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(advisorMapMarkers));
        const map = window.L.map(mapElement).setView(origin, 13);
        window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        const points = [window.L.marker(origin).addTo(map).bindPopup('Địa điểm học tập / làm việc')];
        markers.forEach((room, index) => {
          const popup = document.createElement('span');
          popup.textContent = `Phòng gợi ý ${index + 1}: ${room.title}`;
          points.push(window.L.marker(room.coordinates).addTo(map).bindPopup(popup));
        });
        if (points.length > 1) {
          map.fitBounds(window.L.featureGroup(points).getBounds().pad(0.18), { maxZoom: 14 });
        }
        @if (advisorRadius.HasValue)
        {
          <text>window.L.circle(origin, { radius: @((advisorRadius.Value * 1000).ToString(CultureInfo.InvariantCulture)), color: '#147d70', fillOpacity: 0.06 }).addTo(map);</text>
        }
        window.setTimeout(() => map.invalidateSize(), 100);
      })();
    </script>
  }
}

<section class="rooms-page-hero">
  <div class="container">
    <div class="rooms-page-header">
      <h1 class="rooms-page-title">Tìm <span class="gradient-text">Phòng Trọ</span> Phù Hợp</h1>
      <p class="rooms-page-sub">Lọc theo khu vực, giá, tiện nghi và thời gian phù hợp với nhu cầu của bạn</p>
    </div>
  </div>
</section>

<main class="rooms-main">
  <div class="container">
    <div class="rooms-layout">
      <aside class="rooms-sidebar">
        <form method="get" class="sidebar-card filter-form" asp-action="Rooms" asp-controller="Home">
          <div class="sidebar-header">
            <h3>🔍 Bộ Lọc Nâng Cao</h3>
            <a class="clear-filter-btn" href="/rooms">Xóa tất cả</a>
          </div>

          <div class="filter-group">
            <label class="filter-group-label">Từ khóa</label>
            <input type="text" name="keyword" value="@keyword" placeholder="Tên phòng, địa chỉ..." class="filter-input" />
          </div>

          <div class="filter-group">
            <label class="filter-group-label">Khu vực / Quận</label>
            <select name="district" class="filter-input" data-filter-field="district">
              <option value="">Tất cả</option>
              @foreach (var area in districts)
              {
                <option value="@area" selected="@(district == area ? "selected" : null)">@area</option>
              }
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-group-label" for="sidebar-price-range">Mức giá / tháng</label>
            <select id="sidebar-price-range" name="priceRange" class="filter-input" data-filter-field="priceRange">
              <option value="">Tất cả mức giá</option>
              @foreach (var range in priceLabels)
              {
                <option value="@range.Key" selected="@(priceRange == range.Key ? "selected" : null)">@range.Value</option>
              }
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-group-label">Loại phòng</label>
            <select name="type" class="filter-input" data-filter-field="type">
              <option value="">Tất cả loại phòng</option>
              <option value="single" selected="@(type == "single" ? "selected" : null)">Phòng đơn</option>
              <option value="shared" selected="@(type == "shared" ? "selected" : null)">Ở ghép</option>
              <option value="mini" selected="@(type == "mini" ? "selected" : null)">Căn hộ mini</option>
            </select>
          </div>

          <div class="filter-group">
            <label class="filter-group-label">Tiện nghi</label>
            <p class="filter-hint">Phòng cần có tất cả tiện nghi bạn chọn.</p>
            <div class="filter-checks">
              @foreach (var item in new[] { "Máy lạnh", "Wifi", "Gác lửng", "Chỗ để xe", "Giờ giấc tự do", "Nuôi thú cưng", "Máy giặt", "Không chung chủ" })
              {
                <label class="filter-check">
                  <input type="checkbox" name="amenity" value="@item" checked="@(amenities.Contains(item, StringComparer.OrdinalIgnoreCase) ? "checked" : null)" data-filter-amenity />
                  <span class="fcheck-box"></span>@item
                </label>
              }
            </div>
          </div>

          <div class="filter-group">
            <label class="filter-check verified-check">
              <input type="checkbox" name="verified" value="true" checked="@(verifiedOnly ? "checked" : null)" />
              <span class="fcheck-box"></span>
              Chỉ hiển thị phòng đã xác minh
            </label>
          </div>

          <div class="filter-group">
            <label class="filter-group-label">Sắp xếp</label>
            <select name="sort" class="filter-input" data-filter-field="sort">
              <option value="newest" selected="@(sort == "newest" ? "selected" : null)">Mới nhất</option>
              <option value="price-asc" selected="@(sort == "price-asc" ? "selected" : null)">Giá thấp → cao</option>
              <option value="price-desc" selected="@(sort == "price-desc" ? "selected" : null)">Giá cao → thấp</option>
            </select>
          </div>

          <button type="submit" class="btn-primary w-full">Áp Dụng Bộ Lọc</button>
        </form>
      </aside>

      <section class="rooms-results">
        @if (isAdvisorResults)
        {
          <section class="advisor-search-summary" aria-labelledby="advisor-search-title">
            <div>
              <span class="advisor-search-kicker">Gợi ý từ Trợ lý tìm trọ</span>
              @if (advisorDistanceUnverified)
              {
                <h2 id="advisor-search-title">Phòng phù hợp theo nhu cầu</h2>
              }
              else
              {
                <h2 id="advisor-search-title">Phòng phù hợp gần @advisorPlace</h2>
              }
              <p>
                @if (advisorDistanceUnverified)
                {
                  <span>Chưa định vị được đầy đủ địa chỉ phòng nên chưa thể xác nhận bán kính; danh sách được xếp theo ngân sách và tiện ích. </span>
                }
                else if (advisorRadius.HasValue)
                {
                  <span>Bán kính tối đa @advisorRadius km · </span>
                }
                @if (advisorMinPrice.HasValue && advisorMaxPrice.HasValue)
                {
                  <span>Ngân sách @advisorMinPrice.Value.ToString("#,##0", CultureInfo.GetCultureInfo("vi-VN"))–@advisorMaxPrice.Value.ToString("#,##0", CultureInfo.GetCultureInfo("vi-VN"))đ · </span>
                }
                @if (advisorTransport == "bus")
                {
                  <span>Xe buýt · </span>
                }
                else if (advisorTransport == "bicycle")
                {
                  <span>Xe đạp điện · </span>
                }
                else if (advisorTransport == "motorbike")
                {
                  <span>Xe máy · </span>
                }
                @Model.Count phòng phù hợp được tìm thấy theo ngân sách và tiện ích bạn đã chọn.
              </p>
            </div>
            <a href="/tu-van" class="btn-outline-primary">← Điều chỉnh nhu cầu</a>
          </section>
          @if (advisorLatitude.HasValue && advisorLongitude.HasValue && advisorMapMarkers.Count > 0)
          {
            <div id="advisor-search-map" class="advisor-search-map" role="region" aria-label="Bản đồ các phòng được gợi ý"></div>
            <p class="advisor-search-map-note">Khoảng cách là đường chim bay ước tính. Bản đồ © OpenStreetMap contributors.</p>
          }
        }
        <div class="rooms-toolbar">
          <div class="room-type-tabs" aria-label="Lọc theo loại phòng">
            <button type="button" class="room-type-tab @(string.IsNullOrEmpty(type) ? "active" : "")" data-room-type="">Tất cả phòng</button>
            <button type="button" class="room-type-tab @(type == "single" ? "active" : "")" data-room-type="single">Phòng đơn</button>
            <button type="button" class="room-type-tab @(type == "shared" ? "active" : "")" data-room-type="shared">Ở ghép</button>
            <button type="button" class="room-type-tab @(type == "mini" ? "active" : "")" data-room-type="mini">Căn hộ mini</button>
          </div>
          <div class="toolbar-right">
            <span class="results-count">@Model.Count phòng phù hợp</span>
            <select class="sort-select" data-quick-filter="sort" aria-label="Sắp xếp phòng">
              <option value="newest" selected="@(sort == "newest" ? "selected" : null)">Mới nhất</option>
              <option value="price-asc" selected="@(sort == "price-asc" ? "selected" : null)">Giá thấp → cao</option>
              <option value="price-desc" selected="@(sort == "price-desc" ? "selected" : null)">Giá cao → thấp</option>
            </select>
            <a href="/dang-tin" class="btn-outline-primary rooms-create-link">Đăng tin</a>
            <div class="room-view-switch" aria-label="Kiểu hiển thị">
              <button type="button" class="room-view-button active" data-view-mode="grid" aria-label="Hiển thị dạng lưới" aria-pressed="true">▦</button>
              <button type="button" class="room-view-button" data-view-mode="list" aria-label="Hiển thị dạng danh sách" aria-pressed="false">☰</button>
            </div>
          </div>
        </div>

        <div class="rooms-quick-filters" aria-label="Bộ lọc nhanh">
          <label class="quick-filter">
            <span>📍 Khu vực</span>
            <select class="filter-input" data-quick-filter="district" aria-label="Lọc nhanh theo khu vực">
              <option value="">Toàn bộ khu vực</option>
              @foreach (var area in districts)
              {
                <option value="@area" selected="@(district == area ? "selected" : null)">@area</option>
              }
            </select>
          </label>
          <label class="quick-filter">
            <span>💰 Khoảng giá</span>
            <select class="filter-input" data-quick-filter="priceRange" aria-label="Lọc nhanh theo giá">
              <option value="">Mọi mức giá</option>
              @foreach (var range in priceLabels)
              {
                <option value="@range.Key" selected="@(priceRange == range.Key ? "selected" : null)">@range.Value</option>
              }
            </select>
          </label>
          <div class="quick-filter quick-amenities">
            <span>✨ Tiện nghi</span>
            <div class="quick-amenity-options">
              @foreach (var item in new[] { "Máy lạnh", "Wifi", "Gác lửng", "Chỗ để xe", "Giờ giấc tự do", "Nuôi thú cưng", "Máy giặt", "Không chung chủ" })
              {
                <label class="quick-amenity">
                  <input type="checkbox" value="@item" data-quick-amenity checked="@(amenities.Contains(item, StringComparer.OrdinalIgnoreCase) ? "checked" : null)" />
                  <span>@item</span>
                </label>
              }
            </div>
          </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(keyword) || !string.IsNullOrWhiteSpace(district) || !string.IsNullOrWhiteSpace(type) || !string.IsNullOrWhiteSpace(priceRange) || amenities.Length > 0 || verifiedOnly)
        {
          <div class="active-filters" aria-label="Bộ lọc đang áp dụng">
            <span class="active-filter-title">Đang lọc:</span>
            @if (!string.IsNullOrWhiteSpace(keyword)) { <span class="chip">Từ khóa: @keyword</span> }
            @if (!string.IsNullOrWhiteSpace(district)) { <span class="chip">📍 @district</span> }
            @if (!string.IsNullOrWhiteSpace(priceRange) && priceLabels.TryGetValue(priceRange, out var selectedPrice)) { <span class="chip">💰 @selectedPrice</span> }
            @if (!string.IsNullOrWhiteSpace(type)) { <span class="chip">🏠 @(type == "single" ? "Phòng đơn" : type == "shared" ? "Ở ghép" : "Căn hộ mini")</span> }
            @foreach (var item in amenities) { <span class="chip">✨ @item</span> }
            @if (verifiedOnly) { <span class="chip">✓ Đã xác minh</span> }
          </div>
        }
        @if (!Model.Any())
        {
          <div class="empty-state">
            <h3>Không tìm thấy phòng nào phù hợp</h3>
            <p>Hãy thử giảm bộ lọc hoặc đổi từ khóa khác để xem thêm gợi ý.</p>
            <a href="/rooms" class="btn-primary">Đặt lại bộ lọc</a>
          </div>
        }
        else
        {
          <div class="rooms-grid-list">
            @foreach (var room in Model)
            {
                var image = room.Images.FirstOrDefault()?.Path ?? "https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80";
                var roomAmenities = room.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4).ToArray();
                <article class="room-card list-view">
                  <div class="room-thumb" style="background-image: url('@image');"></div>
                  <div class="room-info">
                    <div class="room-header">
                      <div>
                        <div class="room-badges-row">
                          <span class="room-tag">@(room.IsVerified ? "✓ Đã xác minh" : "Hot")</span>
                          <span class="room-tag muted">@((room.RoomType == "single") ? "Phòng đơn" : (room.RoomType == "shared") ? "Ở ghép" : "Căn hộ mini")</span>
                        </div>
                        <h3 class="room-title"><a href="/phong/@room.Id">@room.Title</a></h3>
                      </div>
                      <span class="room-price">@String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", room.Price)</span>
                    </div>
                    @if (isAdvisorResults && advisorRoomScores.TryGetValue(room.Id, out var fitScore))
                    {
                      <p class="advisor-room-match">
                        <strong>✨ @fitScore% phù hợp</strong>
                        @if (!advisorDistanceUnverified && advisorRoomDistances.TryGetValue(room.Id, out var distanceKm))
                        {
                          <span>· cách địa điểm của bạn @distanceKm.ToString("0.0") km</span>
                        }
                      </p>
                      @if (advisorElectricityKwh.HasValue && advisorOccupants.HasValue)
                      {
                        var estimatedElectricity = (long)room.ElectricPrice * advisorElectricityKwh.Value;
                        var estimatedWater = (long)room.WaterPrice * advisorOccupants.Value;
                        <p class="room-description">Ước tính theo nhu cầu của bạn: điện @String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", estimatedElectricity), nước @String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", estimatedWater) · tổng khoảng @String.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:#,##0}đ", room.Price + estimatedElectricity + estimatedWater)/tháng.</p>
                      }
                    }

                    <div class="room-meta">
                      <span>📍 @room.District</span>
                      <span>📐 @room.Area m²</span>
                      <span>🧭 @room.Address</span>
                    </div>

                    <p class="room-description">@room.Description</p>

                    <div class="feature-list">
                      @foreach (var item in roomAmenities)
                      {
                        <span>@item</span>
                      }
                    </div>

                    <div class="room-actions">
                      <a href="/phong/@room.Id" class="btn-primary">Xem chi tiết</a>
                      <a href="/phong/@room.Id#booking" class="btn-outline-primary">Đặt lịch</a>
                    </div>
                  </div>
                </article>
            }
          </div>
        }
      </section>
    </div>
  </div>
</main>
