@model TroTot.Web.ViewModels.TuVanPageViewModel
@{
    ViewData["Title"] = "Tư Vấn Thuê Phòng Trọ Miễn Phí | TroTot.vn";
    ViewData["Description"] = "Dịch vụ tư vấn tìm phòng trọ 1-on-1 miễn phí từ chuyên gia TroTot.vn. Gợi ý phòng chuẩn ngân sách, an toàn, hỗ trợ xem phòng và ký hợp đồng.";
    ViewData["Icon"] = "💡";
    ViewData["Active"] = "tuvan";
    ViewData["NavScrolled"] = true;
}

@section Styles {
<style>
    .tuvan-hero {
      background: linear-gradient(180deg, #090d1a 0%, #0f172a 100%);
      padding: 120px 0 60px;
      text-align: center;
      position: relative;
    }
    .tuvan-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 36px;
      margin-top: 40px;
    }
    @@media (max-width: 900px) {
      .tuvan-grid { grid-template-columns: 1fr; }
    }
    .consult-card {
      background: linear-gradient(145deg, #111827, #1a2235);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }
    .benefit-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 20px;
    }
    .benefit-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(255, 107, 53, 0.12);
      border: 1px solid rgba(255, 107, 53, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .district-stats-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
      font-size: 13.5px;
    }
    .district-stats-table th {
      text-align: left;
      padding: 12px 14px;
      color: #94a3b8;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      font-weight: 600;
      background: rgba(0,0,0,0.2);
    }
    .district-stats-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      color: #cbd5e1;
    }
    .qa-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 14px;
      transition: border-color 0.2s;
    }
    .qa-card:hover { border-color: rgba(255,107,53,0.3); }
    .qa-question {
      font-size: 15px;
      font-weight: 700;
      color: #f1f5f9;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .qa-answer {
      font-size: 13.5px;
      color: #94a3b8;
      line-height: 1.6;
      padding-left: 26px;
    }
  </style>
}

<!-- ===== NAVIGATION ===== -->


<!-- ===== HERO ===== -->
<section class="tuvan-hero">
  <div class="container">
    <div class="hero-badge" style="margin-bottom:12px;">
      <span class="badge-dot"></span> Đội ngũ chuyên viên tư vấn 24/7
    </div>
    <h1 style="font-size:38px;font-weight:900;color:white;margin-bottom:14px;line-height:1.3;">
      Dịch Vụ Tư Vấn Tìm Trọ <br /><span class="gradient-text">Hoàn Toàn Miễn Phí</span>
    </h1>
    <p style="color:#94a3b8;max-width:620px;margin:0 auto;font-size:16px;">
      Bạn bận rộn hoặc chưa thông thạo khu vực? Hãy để lại nhu cầu, chuyên viên TroTot.vn sẽ sàng lọc phòng tốt nhất và gửi danh sách chi tiết qua Zalo cho bạn trong 30 phút!
    </p>

    <!-- Content Grid -->
    <div class="tuvan-grid">

      <!-- Form tư vấn -->
      <div class="consult-card" style="text-align:left;">
        <h2 style="font-size:22px;font-weight:800;color:#f1f5f9;margin-bottom:8px;display:flex;align-items:center;gap:10px;">
          <span>📋</span> Điền Nhu Cầu Tìm Phòng Của Bạn
        </h2>
        <p style="font-size:13px;color:#94a3b8;margin-bottom:24px;">
          Cam kết bảo mật thông tin 100% • Không thu bất kỳ khoản phí nào từ người thuê.
        </p>

        <form id="consultForm" asp-controller="Home" asp-action="TuVan" method="post">
          <input type="hidden" name="returnUrl" value="/tu-van" />
          <div class="form-row">
            <div class="form-field">
              <label>Họ và tên bạn *</label>
              <input type="text" id="csName" name="Name" class="form-input" placeholder="Nguyễn Văn A" required />
            </div>
            <div class="form-field">
              <label>Số điện thoại (Zalo) *</label>
              <input type="tel" id="csPhone" name="Phone" class="form-input" placeholder="0901234567" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label>Khu vực mong muốn (Quận) *</label>
              <select id="csDistrict" name="District" class="form-input form-select" required>
                <option value="">-- Chọn Quận/Khu vực --</option>
                <option value="cau-giay">Cầu Giấy (Gần ĐHQG, Sư Phạm, Báo Chí)</option>
                <option value="dong-da">Đống Đa (Gần ĐH Ngoại Thương, Luật, Ngoại Giao)</option>
                <option value="thanh-xuan">Thanh Xuân (Gần Nhân Văn, KHTN, ĐH Hà Nội)</option>
                <option value="hai-ba-trung">Hai Bà Trưng (Gần Bách Khoa, Kinh Tế, Xây Dựng)</option>
                <option value="nam-tu-liem">Nam Từ Liêm (Mỹ Đình, Mễ Trì, ĐH Thương Mại)</option>
                <option value="ha-dong">Hà Đông (Gần PTIT, Kiến Trúc, Học viện An Ninh)</option>
                <option value="bac-tu-liem">Bắc Từ Liêm (ĐH Công Nghiệp, HV Tài Chính)</option>
                <option value="ba-dinh">Ba Đình (Trung tâm, ĐH RMIT HN)</option>
                <option value="hoang-mai">Hoàng Mai (Định Công, Giải Phóng, Giáp Bát)</option>
                <option value="tay-ho">Tây Hồ (Ven Hồ Tây, căn hộ cao cấp)</option>
              </select>
            </div>
            <div class="form-field">
              <label>Ngân sách tối đa hàng tháng *</label>
              <select id="csBudget" name="Budget" class="form-input form-select" required>
                <option value="2000000">Dưới 2.000.000 đ/tháng</option>
                <option value="3500000" selected>Từ 2.000.000 – 3.500.000 đ</option>
                <option value="5000000">Từ 3.500.000 – 5.000.000 đ</option>
                <option value="8000000">Từ 5.000.000 – 8.000.000 đ (Studio/Mini)</option>
                <option value="99000000">Trên 8.000.000 đ (Căn hộ dịch vụ)</option>
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label>Loại hình phòng muốn tìm</label>
              <select id="csType" name="RoomType" class="form-input form-select">
                <option value="single">Phòng đơn riêng biệt</option>
                <option value="shared">Ở ghép / Tìm bạn cùng phòng</option>
                <option value="mini">Căn hộ mini / Studio full nội thất</option>
                <option value="any">Loại nào cũng được</option>
              </select>
            </div>
            <div class="form-field">
              <label>Thời gian dự kiến chuyển vào</label>
              <select id="csTime" name="MoveInTime" class="form-input form-select">
                <option value="now">Vào ở ngay trong tuần này</option>
                <option value="2weeks">Trong vòng 2 tuần tới</option>
                <option value="nextmonth">Đầu tháng sau</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label>Tiện nghi bắt buộc cần có:</label>
            <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:8px;margin-top:6px;">
              <label class="filter-check" style="font-size:12.5px;">
                <input type="checkbox" name="Amenities" value="Máy lạnh" /> <span>Máy lạnh</span>
              </label>
              <label class="filter-check" style="font-size:12.5px;">
                <input type="checkbox" name="Amenities" value="Gác lửng" /> <span>Gác lửng</span>
              </label>
              <label class="filter-check" style="font-size:12.5px;">
                <input type="checkbox" name="Amenities" value="Chỗ để xe" checked /> <span>Chỗ để xe</span>
              </label>
              <label class="filter-check" style="font-size:12.5px;">
                <input type="checkbox" name="Amenities" value="Giờ giấc tự do" checked /> <span>Giờ tự do</span>
              </label>
              <label class="filter-check" style="font-size:12.5px;">
                <input type="checkbox" name="Amenities" value="Nuôi thú cưng" /> <span>Nuôi thú cưng</span>
              </label>
              <label class="filter-check" style="font-size:12.5px;">
                <input type="checkbox" name="Amenities" value="Máy giặt" /> <span>Máy giặt</span>
              </label>
            </div>
          </div>

          <div class="form-field" style="margin-top:12px;">
            <label>Địa điểm học tập / làm việc cụ thể</label>
            <input type="text" id="csWorkplace" name="Workplace" class="form-input" placeholder="Ví dụ: Đại học Quốc Gia Hà Nội, ĐH Bách Khoa, Tòa nhà Keangnam..." />
          </div>

          <button type="submit" class="btn-primary" style="width:100%;padding:14px;font-size:16px;font-weight:700;margin-top:12px;">
            🚀 Gửi Yêu Cầu Tư Vấn Ngay
          </button>
        </form>
      </div>

      <!-- Lợi ích khi nhờ tư vấn -->
      <div style="text-align:left;display:flex;flex-direction:column;gap:24px;">
        <div class="consult-card">
          <h3 style="font-size:18px;font-weight:800;color:#f1f5f9;margin-bottom:20px;">
            ✨ Đặc Quyền Dành Cho Bạn
          </h3>

          <div class="benefit-item">
            <div class="benefit-icon">🎯</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Đúng Nhu Cầu 100%</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Không gửi tin rác, chỉ đề xuất các phòng đã kiểm định thực tế sát với ngân sách và địa điểm của bạn.</div>
            </div>
          </div>

          <div class="benefit-item">
            <div class="benefit-icon">⚡</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Phản Hồi Siêu Tốc (30 Phút)</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Chuyên viên kết nối Zalo, gửi video thực tế và bảng chi phí dự toán chi tiết.</div>
            </div>
          </div>

          <div class="benefit-item">
            <div class="benefit-icon">🛡️</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Hỗ Trợ Kiểm Tra Pháp Lý</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Đồng hành cùng bạn đọc kỹ hợp đồng thuê nhà, tránh rủi ro mất cọc oan.</div>
            </div>
          </div>

          <div class="benefit-item" style="margin-bottom:0;">
            <div class="benefit-icon">🎁</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Miễn Phí Dẫn Xem Phòng</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Hỗ trợ đặt lịch, hướng dẫn kiểm tra trang thiết bị và đàm phán giá tốt nhất.</div>
            </div>
          </div>
        </div>

        <!-- Hotline Card -->
        <div class="consult-card" style="background:linear-gradient(135deg, rgba(255,107,53,0.15), rgba(255,140,66,0.05));border-color:rgba(255,107,53,0.3);">
          <div style="font-size:13px;color:#ff8c42;font-weight:700;text-transform:uppercase;margin-bottom:6px;">Cần tư vấn khẩn cấp?</div>
          <div style="font-size:24px;font-weight:900;color:white;margin-bottom:8px;">Hotline: 1900 1234</div>
          <div style="font-size:13px;color:#94a3b8;margin-bottom:14px;">Hoạt động từ 08:00 - 22:00 tất cả các ngày trong tuần (kể cả Thứ 7 & CN).</div>
          <a href="tel:19001234" class="btn-ghost" style="display:inline-block;border-color:rgba(255,107,53,0.4);color:#ff8c42;font-weight:700;text-decoration:none;padding:10px 20px;">
            📞 Gọi Ngay Bây Giờ
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ===== PHÂN TÍCH THÔNG TIN KHU VỰC ===== -->
<section style="padding:60px 0;background:#0c1222;border-top:1px solid rgba(255,255,255,0.05);">
  <div class="container">
    <div style="text-align:center;max-width:680px;margin:0 auto 36px;">
      <h2 style="font-size:28px;font-weight:800;color:#f1f5f9;margin-bottom:10px;">
        📊 Báo Cáo Mức Giá & An Ninh Theo Từng Khu Vực
      </h2>
      <p style="color:#94a3b8;font-size:14px;">
        Số liệu được tổng hợp theo thời gian thực từ hơn 5,000+ tin đăng và khảo sát thực tế tại Hà Nội
      </p>
    </div>

    <div style="background:linear-gradient(145deg, #111827, #1a2235);border:1px solid rgba(255,255,255,0.08);border-radius:20px;overflow:hidden;box-shadow:0 15px 35px rgba(0,0,0,0.3);">
      <div style="overflow-x:auto;">
        <table class="district-stats-table">
          <thead>
            <tr>
              <th>Khu vực / Quận</th>
              <th>Mức giá trung bình</th>
              <th>Độ an ninh</th>
              <th>Trường đại học trọng điểm</th>
              <th>Đặc điểm nổi bật</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong style="color:#ff8c42;">Cầu Giấy</strong></td>
              <td>3.2 – 4.5 triệu</td>
              <td><span style="color:#34d399;font-weight:600;">● Rất tốt</span></td>
              <td>ĐH Quốc Gia, ĐH Sư Phạm, Học viện Báo Chí</td>
              <td>Sầm uất, nhiều toà nhà văn phòng Duy Tân, Cầu Giấy</td>
            </tr>
            <tr>
              <td><strong style="color:#ff8c42;">Đống Đa</strong></td>
              <td>3.5 – 5.2 triệu</td>
              <td><span style="color:#34d399;font-weight:600;">● Xuất sắc</span></td>
              <td>ĐH Ngoại Thương, ĐH Luật, Học viện Ngoại Giao</td>
              <td>Vị trí trung tâm nội thành, ngõ Chùa Láng ẩm thực nổi tiếng</td>
            </tr>
            <tr>
              <td><strong style="color:#ff8c42;">Thanh Xuân</strong></td>
              <td>2.8 – 3.8 triệu</td>
              <td><span style="color:#34d399;font-weight:600;">● Rất tốt</span></td>
              <td>ĐH KHXH&NV, ĐH KHTN, ĐH Hà Nội</td>
              <td>Trục đường Nguyễn Trãi, có tuyến tàu điện Metro Cát Linh</td>
            </tr>
            <tr>
              <td><strong style="color:#ff8c42;">Hai Bà Trưng</strong></td>
              <td>2.8 – 4.0 triệu</td>
              <td><span style="color:#34d399;font-weight:600;">● Tốt</span></td>
              <td>ĐH Bách Khoa HN, Kinh Tế Quốc Dân, Xây Dựng</td>
              <td>Cụm trường Bách – Kinh – Xây sầm uất, nhiều quán ăn sinh viên</td>
            </tr>
            <tr>
              <td><strong style="color:#ff8c42;">Nam Từ Liêm</strong></td>
              <td>3.0 – 4.6 triệu</td>
              <td><span style="color:#34d399;font-weight:600;">● Rất tốt</span></td>
              <td>ĐH Thương Mại, SVĐ Mỹ Đình, Keangnam</td>
              <td>Nhiều chung cư mini mới xây, đường rộng, không kẹt xe</td>
            </tr>
            <tr>
              <td><strong style="color:#ff8c42;">Hà Đông</strong></td>
              <td>2.0 – 3.0 triệu</td>
              <td><span style="color:#f59e0b;font-weight:600;">● Ổn định</span></td>
              <td>Học viện Bưu Chính (PTIT), Kiến Trúc, An Ninh</td>
              <td>Giá thuê rẻ, phòng rộng rãi, kết nối tàu điện trên cao</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- ===== CỘNG ĐỒNG HỎI ĐÁP (FAQ & Q&A) ===== -->
<section style="padding:60px 0;background:#090d1a;">
  <div class="container" style="max-width:960px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:30px;flex-wrap:wrap;gap:16px;">
      <div>
        <h2 style="font-size:26px;font-weight:800;color:#f1f5f9;margin-bottom:6px;">
          💬 Cộng Đồng Hỏi Đáp & Thắc Mắc Tìm Trọ
        </h2>
        <p style="color:#94a3b8;font-size:14px;">
          Những câu hỏi thực tế được giải đáp bởi chuyên gia và cư dân mạng
        </p>
      </div>
      <button class="btn-primary" onclick="openAskModal()">
        + Đặt Câu Hỏi Mới
      </button>
    </div>

    <!-- Questions list -->
    <div id="qaContainer">
      @foreach (var q in Model.Questions)
      {
        <div class="qa-card">
          <div class="qa-question">
            <span>❓</span>
            <span>@q.Content</span>
          </div>
          @if (!string.IsNullOrWhiteSpace(q.Answer))
          {
            <div class="qa-answer">
              <strong style="color:#ff8c42;">Chuyên gia TroTot:</strong> @q.Answer
            </div>
          }
          else
          {
            <div class="qa-answer" style="color:#f59e0b;">
              <em>⏳ Câu hỏi của bạn đã được gửi thành công và đang được chuyên gia TroTot duyệt giải đáp...</em>
            </div>
          }
        </div>
      }
    </div>
  </div>
</section>

<!-- ===== MODAL: ĐẶT CÂU HỎI MỚI ===== -->
<div class="modal" id="askModal" style="display:none;">
  <div class="modal-backdrop" onclick="closeModal('askModal')"></div>
  <div class="modal-dialog" style="max-width:480px;">
    <div class="modal-header">
      <h3 class="modal-title">💬 Đặt Câu Hỏi Cho Cộng Đồng</h3>
      <button class="modal-close" onclick="closeModal('askModal')">✕</button>
    </div>
    <form asp-controller="Home" asp-action="HoiDap" method="post">
      <div class="modal-body">
        <div class="form-field">
          <label>Chủ đề câu hỏi</label>
          <select id="askTopic" name="Topic" class="form-input form-select">
            <option value="contract">Hợp đồng & Tiền cọc</option>
            <option value="price">Chi phí điện nước & Giá phòng</option>
            <option value="security">An ninh & Khu vực</option>
            <option value="shared">Kinh nghiệm tìm người ở ghép</option>
            <option value="other">Chủ đề khác</option>
          </select>
        </div>
        <div class="form-field">
          <label>Nội dung thắc mắc của bạn *</label>
          <textarea id="askText" name="Content" rows="4" class="form-input" placeholder="Hãy mô tả cụ thể tình huống bạn đang băn khoăn để nhận câu trả lời chính xác nhất..." required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-ghost" onclick="closeModal('askModal')">Hủy</button>
        <button type="submit" class="btn-primary">Đăng Câu Hỏi</button>
      </div>
    </form>
  </div>
</div>

<!-- ===== FOOTER ===== -->


<div id="toastContainer" class="toast-container"></div>

@section Scripts {
<script>
  function openAskModal() {
    document.getElementById('askModal').style.display = 'flex';
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.textContent = message;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  }
</script>
}
