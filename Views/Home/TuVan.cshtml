@model TroTot.Web.ViewModels.TuVanPageViewModel
@{
    ViewData["Title"] = "Tư Vấn Thuê Phòng Trọ Miễn Phí | TroTot.vn";
    ViewData["Description"] = "Dịch vụ tư vấn tìm phòng trọ 1-on-1 miễn phí từ chuyên gia TroTot.vn. Gợi ý phòng chuẩn ngân sách, an toàn, hỗ trợ xem phòng và ký hợp đồng.";
    ViewData["Icon"] = "💡";
    ViewData["Active"] = "tuvan";
    ViewData["NavScrolled"] = true;
}

@section Styles {
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<style>
    .tuvan-hero {
      background: linear-gradient(180deg, #090d1a 0%, #0f172a 100%);
      padding: 120px 0 60px;
      text-align: center;
      position: relative;
    }
    .tuvan-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 36px;
      margin-top: 40px;
    }
    @@media (max-width: 900px) {
      .tuvan-grid { grid-template-columns: 1fr; }
    }
    .consult-card {
      background: linear-gradient(145deg, #111827, #1a2235);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 24px;
      padding: 32px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }
    .benefit-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      margin-bottom: 20px;
    }
    .benefit-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: rgba(255, 107, 53, 0.12);
      border: 1px solid rgba(255, 107, 53, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .district-stats-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
      font-size: 13.5px;
    }
    .district-stats-table th {
      text-align: left;
      padding: 12px 14px;
      color: #94a3b8;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      font-weight: 600;
      background: rgba(0,0,0,0.2);
    }
    .district-stats-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      color: #cbd5e1;
    }
    .qa-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 14px;
      padding: 18px;
      margin-bottom: 14px;
      transition: border-color 0.2s;
    }
    .qa-card:hover { border-color: rgba(255,107,53,0.3); }
    .qa-question {
      font-size: 15px;
      font-weight: 700;
      color: #f1f5f9;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .qa-answer {
      font-size: 13.5px;
      color: #94a3b8;
      line-height: 1.6;
      padding-left: 26px;
    }
    .advisor-step { display: grid; gap: 18px; }
    .advisor-step[hidden] { display: none; }
    .advisor-progress { display: flex; gap: 8px; margin: 20px 0; }
    .advisor-progress span { flex: 1; height: 5px; border-radius: 99px; background: #334155; }
    .advisor-progress span.active { background: #ff8c42; }
    .advisor-field { display: grid; gap: 7px; }
    .advisor-field label, .advisor-field legend { color: #e2e8f0; font-size: 13px; font-weight: 700; }
    .advisor-field input[type="text"], .advisor-field select { width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid #334155; border-radius: 10px; color: #f8fafc; background: #0f172a; }
    .advisor-field input[type="range"] { width: 100%; accent-color: #ff8c42; }
    .advisor-two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .advisor-value { color: #ffb47d; font-weight: 800; }
    .advisor-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; padding: 0; border: 0; }
    .advisor-options legend { grid-column: 1 / -1; margin-bottom: 4px; }
    .advisor-option { display: flex; align-items: center; gap: 8px; padding: 10px; border: 1px solid #334155; border-radius: 10px; color: #cbd5e1; font-size: 12px; cursor: pointer; }
    .advisor-option input { accent-color: #ff8c42; }
    .advisor-actions { display: flex; gap: 10px; }
    .advisor-actions button { flex: 1; }
    .advisor-status { min-height: 22px; color: #ffb47d; }
    @@media (max-width: 620px) {
      .advisor-two-col { grid-template-columns: 1fr; }
    }
  </style>
}

<!-- ===== NAVIGATION ===== -->


<!-- ===== HERO ===== -->
<section class="tuvan-hero">
  <div class="container">
    <div class="hero-badge" style="margin-bottom:12px;">
      <span class="badge-dot"></span> Trợ lý tìm phòng tức thì
    </div>
    <h1 style="font-size:38px;font-weight:900;color:white;margin-bottom:14px;line-height:1.3;">
    Trợ Lý Tìm Trọ <br /><span class="gradient-text">Thông Minh &amp; Miễn Phí</span>
    </h1>
    <p style="color:#94a3b8;max-width:620px;margin:0 auto;font-size:16px;">
    Chọn nơi học/làm, ngân sách và tiện ích. Hệ thống sẽ lọc phòng phù hợp, ước tính khoảng cách và giải thích cách chấm điểm.
    </p>

    <!-- Content Grid -->
    <div class="tuvan-grid">

      <!-- Form tư vấn -->
      <div class="consult-card" style="text-align:left;">
        <h2 style="font-size:22px;font-weight:800;color:#f1f5f9;margin-bottom:8px;">🧭 Tìm phòng theo nhu cầu</h2>
        <p style="font-size:13px;color:#94a3b8;margin-bottom:12px;">Không cần đăng nhập. Địa điểm được gửi tới OpenStreetMap để tìm tọa độ; vui lòng không nhập thông tin nhạy cảm.</p>
        <div class="advisor-progress" aria-label="Tiến trình tư vấn"><span class="active" data-advisor-progress="1"></span><span data-advisor-progress="2"></span><span data-advisor-progress="3"></span></div>

        <form id="advisor-form" data-ajax-ignore>
          @Html.AntiForgeryToken()
          <section class="advisor-step" id="advisor-step-1">
            <div class="advisor-field">
              <label for="advisor-place">Trường học hoặc nơi làm việc</label>
              <input id="advisor-place" type="text" maxlength="180" required placeholder="VD: Đại học Bách Khoa Hà Nội" autocomplete="street-address" />
            </div>
            <div class="advisor-two-col">
              <div class="advisor-field">
                <label for="advisor-radius">Bán kính mong muốn: <span class="advisor-value" id="advisor-radius-value">5 km</span></label>
                <input id="advisor-radius" type="range" min="1" max="15" value="5" />
              </div>
              <div class="advisor-field">
                <label for="advisor-transport">Phương tiện di chuyển</label>
                <select id="advisor-transport">
                  <option value="motorbike">Xe máy</option>
                  <option value="bicycle">Xe đạp điện</option>
                  <option value="bus">Xe buýt</option>
                </select>
              </div>
            </div>
            <button type="button" class="btn-primary" data-advisor-next="2">Tiếp tục chọn ngân sách →</button>
          </section>

          <section class="advisor-step" id="advisor-step-2" hidden>
            <div class="advisor-two-col">
              <div class="advisor-field">
                <label for="advisor-min-rent">Giá thuê tối thiểu: <span class="advisor-value" id="advisor-min-value"></span></label>
                <input id="advisor-min-rent" type="range" min="500000" max="10000000" step="250000" value="1000000" />
              </div>
              <div class="advisor-field">
                <label for="advisor-max-rent">Giá thuê tối đa: <span class="advisor-value" id="advisor-max-value"></span></label>
                <input id="advisor-max-rent" type="range" min="1000000" max="15000000" step="250000" value="6000000" />
              </div>
            </div>
            <p class="advisor-note">Ước tính điện/nước dựa trên mức sử dụng mỗi tháng; kết quả dùng đơn giá điện/nước của từng tin phòng.</p>
            <div class="advisor-two-col">
              <div class="advisor-field">
                <label for="advisor-electricity">Điện dự kiến: <span class="advisor-value" id="advisor-electricity-value">70 kWh/tháng</span></label>
                <input id="advisor-electricity" type="range" min="0" max="200" step="10" value="70" />
              </div>
              <div class="advisor-field">
                <label for="advisor-water">Số người ở: <span class="advisor-value" id="advisor-water-value">1 người</span></label>
                <input id="advisor-water" type="range" min="1" max="6" step="1" value="1" />
              </div>
            </div>
            <fieldset class="advisor-options">
              <legend>Tiện ích ưu tiên</legend>
              <label class="advisor-option"><input type="checkbox" value="Máy lạnh" /> Có điều hòa</label>
              <label class="advisor-option"><input type="checkbox" value="Máy giặt" /> Máy giặt</label>
              <label class="advisor-option"><input type="checkbox" value="Giờ giấc tự do" /> Giờ giấc tự do</label>
              <label class="advisor-option"><input type="checkbox" value="Không chung chủ" /> Không chung chủ</label>
            </fieldset>
            <div class="advisor-actions">
              <button type="button" class="btn-ghost" data-advisor-next="1">← Quay lại</button>
              <button type="submit" class="btn-primary" id="advisor-submit">🔎 Phân Tích &amp; Tư Vấn Ngay</button>
            </div>
          </section>
        </form>

        <p id="advisor-status" class="advisor-status" role="status" aria-live="polite"></p>
      </div>

      <!-- Lợi ích khi nhờ tư vấn -->
      <div style="text-align:left;display:flex;flex-direction:column;gap:24px;">
        <div class="consult-card">
          <h3 style="font-size:18px;font-weight:800;color:#f1f5f9;margin-bottom:20px;">
            ✨ Đặc Quyền Dành Cho Bạn
          </h3>

          <div class="benefit-item">
            <div class="benefit-icon">🎯</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Lọc theo nhu cầu</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">So sánh ngân sách, tiện ích đã khai báo và vị trí phòng với địa điểm bạn chọn.</div>
            </div>
          </div>

          <div class="benefit-item">
            <div class="benefit-icon">⚡</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Ước tính chi phí hàng tháng</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Dự toán tiền điện theo mức sử dụng và đơn giá trong tin; tiền nước theo số người ở.</div>
            </div>
          </div>

          <div class="benefit-item">
            <div class="benefit-icon">🛡️</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Điểm gợi ý minh bạch</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Điểm được tính từ giá, tiện ích và trạng thái xác minh; không thay thế việc xem phòng trực tiếp.</div>
            </div>
          </div>

          <div class="benefit-item" style="margin-bottom:0;">
            <div class="benefit-icon">🎁</div>
            <div>
              <div style="font-weight:700;color:#f1f5f9;font-size:15px;margin-bottom:3px;">Bạn quyết định chia sẻ thông tin</div>
              <div style="font-size:13px;color:#94a3b8;line-height:1.5;">Chỉ khi gửi yêu cầu liên hệ, thông tin tên và số điện thoại mới được lưu để chuyên viên hỗ trợ.</div>
            </div>
          </div>
        </div>

        <!-- Hotline Card -->
        <div class="consult-card" style="background:linear-gradient(135deg, rgba(255,107,53,0.15), rgba(255,140,66,0.05));border-color:rgba(255,107,53,0.3);">
          <div style="font-size:13px;color:#ff8c42;font-weight:700;text-transform:uppercase;margin-bottom:6px;">Cần tư vấn khẩn cấp?</div>
          <div style="font-size:24px;font-weight:900;color:white;margin-bottom:8px;">Hotline: 1900 1234</div>
          <div style="font-size:13px;color:#94a3b8;margin-bottom:14px;">Hoạt động từ 08:00 - 22:00 tất cả các ngày trong tuần (kể cả Thứ 7 & CN).</div>
          <a href="tel:19001234" class="btn-ghost" style="display:inline-block;border-color:rgba(255,107,53,0.4);color:#ff8c42;font-weight:700;text-decoration:none;padding:10px 20px;">
            📞 Gọi Ngay Bây Giờ
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<section style="padding:30px 0;background:#0c1222;border-top:1px solid rgba(255,255,255,0.05);">
  <div class="container">
    <p class="advisor-note" style="max-width:900px;margin:auto;text-align:center;">Ứng dụng chưa có dữ liệu xác thực về an ninh, ngập lụt, lối vào hoặc tuyến giao thông. Trợ lý không tự suy đoán các thông tin này; vui lòng xác nhận với chủ trọ và khảo sát thực tế trước khi thuê.</p>
  </div>
</section>

<!-- ===== CỘNG ĐỒNG HỎI ĐÁP (FAQ & Q&A) ===== -->
<section style="padding:60px 0;background:#090d1a;">
  <div class="container" style="max-width:960px;">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:30px;flex-wrap:wrap;gap:16px;">
      <div>
        <h2 style="font-size:26px;font-weight:800;color:#f1f5f9;margin-bottom:6px;">
          💬 Cộng Đồng Hỏi Đáp & Thắc Mắc Tìm Trọ
        </h2>
        <p style="color:#94a3b8;font-size:14px;">
          Những câu hỏi thực tế được giải đáp bởi chuyên gia và cư dân mạng
        </p>
      </div>
      <button class="btn-primary" onclick="openAskModal()">
        + Đặt Câu Hỏi Mới
      </button>
    </div>

    <!-- Questions list -->
    <div id="qaContainer">
      @foreach (var q in Model.Questions)
      {
        <div class="qa-card">
          <div class="qa-question">
            <span>❓</span>
            <span>@q.Content</span>
          </div>
          @if (!string.IsNullOrWhiteSpace(q.Answer))
          {
            <div class="qa-answer">
              <strong style="color:#ff8c42;">Chuyên gia TroTot:</strong> @q.Answer
            </div>
          }
          else
          {
            <div class="qa-answer" style="color:#f59e0b;">
              <em>⏳ Câu hỏi của bạn đã được gửi thành công và đang được chuyên gia TroTot duyệt giải đáp...</em>
            </div>
          }
        </div>
      }
    </div>
  </div>
</section>

<!-- ===== MODAL: ĐẶT CÂU HỎI MỚI ===== -->
<div class="modal" id="askModal" style="display:none;">
  <div class="modal-backdrop" onclick="closeModal('askModal')"></div>
  <div class="modal-dialog" style="max-width:480px;">
    <div class="modal-header">
      <h3 class="modal-title">💬 Đặt Câu Hỏi Cho Cộng Đồng</h3>
      <button class="modal-close" onclick="closeModal('askModal')">✕</button>
    </div>
    <form asp-controller="Home" asp-action="HoiDap" method="post">
      <div class="modal-body">
        <div class="form-field">
          <label>Chủ đề câu hỏi</label>
          <select id="askTopic" name="Topic" class="form-input form-select">
            <option value="contract">Hợp đồng & Tiền cọc</option>
            <option value="price">Chi phí điện nước & Giá phòng</option>
            <option value="security">An ninh & Khu vực</option>
            <option value="shared">Kinh nghiệm tìm người ở ghép</option>
            <option value="other">Chủ đề khác</option>
          </select>
        </div>
        <div class="form-field">
          <label>Nội dung thắc mắc của bạn *</label>
          <textarea id="askText" name="Content" rows="4" class="form-input" placeholder="Hãy mô tả cụ thể tình huống bạn đang băn khoăn để nhận câu trả lời chính xác nhất..." required></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-ghost" onclick="closeModal('askModal')">Hủy</button>
        <button type="submit" class="btn-primary">Đăng Câu Hỏi</button>
      </div>
    </form>
  </div>
</div>

<!-- ===== FOOTER ===== -->


<div id="toastContainer" class="toast-container"></div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
  (() => {
    const form = document.getElementById('advisor-form');
    if (!form) return;

    const status = document.getElementById('advisor-status');
    const progressSteps = [...document.querySelectorAll('[data-advisor-progress]')];
    const cachedRoomLocations = new Map();
    let lastGeocodeRequest = 0;
    let analysisController = null;

    const formatPrice = value => `${new Intl.NumberFormat('vi-VN').format(value)} đ`;

    const updateRangeLabels = () => {
      const minRent = document.getElementById('advisor-min-rent');
      const maxRent = document.getElementById('advisor-max-rent');
      if (Number(minRent.value) > Number(maxRent.value)) {
        if (document.activeElement === minRent) maxRent.value = minRent.value;
        else minRent.value = maxRent.value;
      }
      document.getElementById('advisor-min-value').textContent = formatPrice(Number(minRent.value));
      document.getElementById('advisor-max-value').textContent = formatPrice(Number(maxRent.value));
      document.getElementById('advisor-electricity-value').textContent =
        `${document.getElementById('advisor-electricity').value} kWh/tháng`;
      document.getElementById('advisor-water-value').textContent =
        `${document.getElementById('advisor-water').value} người`;
    };

    document.querySelectorAll('#advisor-min-rent, #advisor-max-rent, #advisor-electricity, #advisor-water')
      .forEach(input => input.addEventListener('input', updateRangeLabels));
    updateRangeLabels();

    document.getElementById('advisor-radius').addEventListener('input', event => {
      document.getElementById('advisor-radius-value').textContent = `${event.target.value} km`;
    });

    const setStep = step => {
      document.querySelectorAll('.advisor-step').forEach(section => {
        section.hidden = section.id !== `advisor-step-${step}`;
      });
      progressSteps.forEach((item, index) => item.classList.toggle('active', index < step));
      status.textContent = '';
    };

    document.querySelectorAll('[data-advisor-next]').forEach(button => {
      button.addEventListener('click', () => {
        if (button.dataset.advisorNext === '2' &&
            !document.getElementById('advisor-place').reportValidity()) return;
        setStep(Number(button.dataset.advisorNext));
      });
    });

    const geocode = async (query, signal, cacheable = false) => {
      const cached = cacheable ? cachedRoomLocations.get(query) : null;
      if (cached) return cached;

      const delay = Math.max(0, 1100 - (Date.now() - lastGeocodeRequest));
      if (delay) await new Promise(resolve => window.setTimeout(resolve, delay));
      if (signal.aborted) throw new DOMException('Yêu cầu đã hủy.', 'AbortError');

      const url = new URL('https://nominatim.openstreetmap.org/search');
      url.search = new URLSearchParams({
        q: query,
        format: 'jsonv2',
        limit: '1',
        countrycodes: 'vn',
        'accept-language': 'vi'
      });
      lastGeocodeRequest = Date.now();
      const response = await fetch(url, {
        signal,
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) throw new Error('Không thể tìm tọa độ trên OpenStreetMap. Vui lòng thử lại sau.');
      const matches = await response.json();
      if (!Array.isArray(matches) || matches.length === 0) return null;

      const location = {
        lat: Number(matches[0].lat),
        lon: Number(matches[0].lon)
      };
      if (!Number.isFinite(location.lat) || !Number.isFinite(location.lon)) return null;
      if (cacheable) cachedRoomLocations.set(query, location);
      return location;
    };

    const calculateDistanceKm = (first, second) => {
      const radians = degrees => degrees * Math.PI / 180;
      const latDelta = radians(second.lat - first.lat);
      const lonDelta = radians(second.lon - first.lon);
      const haversine = Math.sin(latDelta / 2) ** 2 +
        Math.cos(radians(first.lat)) * Math.cos(radians(second.lat)) *
        Math.sin(lonDelta / 2) ** 2;
      return 6371 * 2 * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine));
    };

    const goToRoomSuggestions = async (rooms, place, radiusKm, distanceUnverified) => {
      const searchParams = new URLSearchParams();
      rooms.forEach(room => {
        searchParams.append('recommendedRoomIds', room.id);
        searchParams.append('advisorScores', room.finalScore);
        if (Number.isFinite(room.distanceKm)) {
          searchParams.append('advisorDistances', room.distanceKm.toFixed(2));
        }
        if (room.location) {
          searchParams.append('advisorRoomLats', room.location.lat);
          searchParams.append('advisorRoomLons', room.location.lon);
        }
      });
      if (place) {
        searchParams.set('advisorLat', place.lat);
        searchParams.set('advisorLon', place.lon);
      }
      searchParams.set('advisorDistanceUnverified', String(distanceUnverified));
      searchParams.set('advisorRadiusKm', radiusKm);
      searchParams.set('advisorPlace', document.getElementById('advisor-place').value.trim());
      searchParams.set('advisorTransport', document.getElementById('advisor-transport').value);
      searchParams.set('advisorElectricityKwh', document.getElementById('advisor-electricity').value);
      searchParams.set('advisorOccupants', document.getElementById('advisor-water').value);
      searchParams.set('minPrice', document.getElementById('advisor-min-rent').value);
      searchParams.set('maxPrice', document.getElementById('advisor-max-rent').value);
      [...form.querySelectorAll('.advisor-options input:checked')]
        .forEach(input => searchParams.append('amenity', input.value));

      const searchUrl = `/rooms?${searchParams.toString()}`;
      status.textContent = 'Đã tìm thấy phòng phù hợp. Đang chuyển đến trang tìm phòng…';
      if (typeof window.__troTotNavigate === 'function') {
        await window.__troTotNavigate(searchUrl);
      } else {
        window.location.assign(searchUrl);
      }
    };

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (analysisController) analysisController.abort();
      analysisController = new AbortController();
      const { signal } = analysisController;
      const submitButton = document.getElementById('advisor-submit');
      submitButton.disabled = true;
      progressSteps.forEach((item, index) => item.classList.toggle('active', index < 2));
      status.textContent = 'Đang lọc phòng và định vị địa điểm trên OpenStreetMap…';

      try {
        const selected = [...form.querySelectorAll('.advisor-options input:checked')].map(input => input.value);
        const query = new URLSearchParams({
          minRent: document.getElementById('advisor-min-rent').value,
          maxRent: document.getElementById('advisor-max-rent').value
        });
        selected.forEach(amenity => query.append('amenity', amenity));
        const response = await fetch(`/api/rooms/recommendations?${query}`, {
          signal,
          headers: { Accept: 'application/json' }
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Không thể tải danh sách phòng phù hợp.');
        if (!data.recommendations.length) {
          throw new Error('Chưa tìm thấy phòng trong khoảng giá này. Hãy thử nới rộng ngân sách hoặc bỏ bớt tiện ích.');
        }

        const placeQuery = `${document.getElementById('advisor-place').value.trim()}, Hà Nội, Việt Nam`;
        const radiusKm = Number(document.getElementById('advisor-radius').value);
        let place = null;
        try {
          place = await geocode(placeQuery, signal);
        } catch (error) {
          if (error.name === 'AbortError') throw error;
        }
        if (!place) {
          const fallbackRooms = data.recommendations.slice(0, 3).map(room => ({
            ...room,
            finalScore: room.fitScore,
            distanceKm: null,
            location: null
          }));
          await goToRoomSuggestions(fallbackRooms, null, radiusKm, true);
          return;
        }

        const candidates = [];
        const unmappedRooms = [];
        for (const room of data.recommendations.slice(0, 6)) {
          status.textContent = `Đang kiểm tra vị trí phòng (${candidates.length + unmappedRooms.length + 1}/6)…`;
          const locationQuery = `${room.address}, ${room.district}, Hà Nội, Việt Nam`;
          let location;
          try {
            location = await geocode(locationQuery, signal, true);
          } catch (error) {
            if (error.name === 'AbortError') throw error;
            unmappedRooms.push(room.title);
            continue;
          }
          if (!location) {
            unmappedRooms.push(room.title);
            continue;
          }

          const distanceKm = calculateDistanceKm(place, location);
          if (distanceKm <= radiusKm) {
            const distanceScore = Math.max(0, 1 - distanceKm / radiusKm);
            candidates.push({
              ...room,
              location,
              distanceKm,
              finalScore: Math.round(room.fitScore * 0.75 + distanceScore * 25)
            });
          }
        }

        const topRooms = candidates
          .sort((first, second) => second.finalScore - first.finalScore || first.distanceKm - second.distanceKm)
          .slice(0, 3);
        if (!topRooms.length) {
          if (!unmappedRooms.length) {
            throw new Error(`Chưa có phòng được xác nhận trong bán kính ${radiusKm} km. Hãy thử tăng bán kính hoặc điều chỉnh ngân sách.`);
          }

          const fallbackRooms = data.recommendations.slice(0, 3).map(room => ({
            ...room,
            finalScore: room.fitScore,
            distanceKm: null,
            location: null
          }));
          await goToRoomSuggestions(fallbackRooms, place, radiusKm, true);
          return;
        }

        await goToRoomSuggestions(topRooms, place, radiusKm, false);
      } catch (error) {
        if (error.name !== 'AbortError') {
          status.textContent = error.message || 'Không thể hoàn thành phân tích. Vui lòng thử lại.';
        }
      } finally {
        if (analysisController?.signal === signal) {
          submitButton.disabled = false;
          analysisController = null;
        }
      }
    });
  })();

  function openAskModal() {
    document.getElementById('askModal').style.display = 'flex';
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    if (!container) return;
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.textContent = message;
    container.appendChild(toast);
    setTimeout(() => toast.remove(), 4000);
  }
</script>
}
