@{
    ViewData["Title"] = "Liên Hệ Hỗ Trợ 24/7 | TroTot.vn";
    ViewData["Description"] = "Liên hệ tổng đài tư vấn phòng trọ TroTot.vn. Hỗ trợ tìm trọ, hỗ trợ chủ trọ đăng tin và giải quyết sự cố 24/7.";
    ViewData["Icon"] = "📞";
    ViewData["Active"] = "lienhe";
    ViewData["NavScrolled"] = true;
}

<!-- NAVIGATION -->


<div style="background:linear-gradient(180deg, #090d1a 0%, #0f172a 100%);padding:120px 0 60px;">
  <div class="container" style="max-width:960px;">
    <div style="text-align:center;margin-bottom:40px;">
      <h1 style="font-size:36px;font-weight:900;color:white;margin-bottom:12px;">Liên Hệ Với Chúng Tôi</h1>
      <p style="color:#94a3b8;font-size:15px;">Đội ngũ hỗ trợ khách hàng và chủ trọ luôn sẵn sàng 24/7</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));gap:20px;margin-bottom:40px;">
      <div style="background:linear-gradient(145deg, #111827, #1a2235);border:1px solid rgba(255,255,255,0.08);border-radius:18px;padding:24px;text-align:center;">
        <div style="font-size:36px;margin-bottom:10px;">📞</div>
        <h3 style="font-size:16px;font-weight:700;color:#f8fafc;margin-bottom:6px;">Tổng Đài Tư Vấn</h3>
        <div style="font-size:20px;font-weight:900;color:#ff6b35;margin-bottom:6px;">1900 1234</div>
        <div style="font-size:12px;color:#64748b;">(08:00 - 22:00 Hàng ngày)</div>
      </div>

      <div style="background:linear-gradient(145deg, #111827, #1a2235);border:1px solid rgba(255,255,255,0.08);border-radius:18px;padding:24px;text-align:center;">
        <div style="font-size:36px;margin-bottom:10px;">💬</div>
        <h3 style="font-size:16px;font-weight:700;color:#f8fafc;margin-bottom:6px;">Zalo Hỗ Trợ Nhanh</h3>
        <div style="font-size:20px;font-weight:900;color:#38bdf8;margin-bottom:6px;">0909 888 999</div>
        <div style="font-size:12px;color:#64748b;">(Phản hồi trong 5 phút)</div>
      </div>

      <div style="background:linear-gradient(145deg, #111827, #1a2235);border:1px solid rgba(255,255,255,0.08);border-radius:18px;padding:24px;text-align:center;">
        <div style="font-size:36px;margin-bottom:10px;">🏢</div>
        <h3 style="font-size:16px;font-weight:700;color:#f8fafc;margin-bottom:6px;">Trụ Sở Chính</h3>
        <div style="font-size:14px;font-weight:700;color:#cbd5e1;margin-bottom:6px;">Tòa nhà Innovation Hub</div>
        <div style="font-size:12px;color:#64748b;">Quận Cầu Giấy, TP. Hà Nội</div>
      </div>
    </div>

    <!-- Contact Form -->
    <div style="background:linear-gradient(145deg, #111827, #1a2235);border:1px solid rgba(255,255,255,0.08);border-radius:24px;padding:36px;">
      <h2 style="font-size:22px;font-weight:800;color:#f1f5f9;margin-bottom:20px;">Gửi Tin Nhắn Phản Hồi</h2>
      <form asp-controller="Home" asp-action="LienHe" method="post">
        <div class="form-row">
          <div class="form-field">
            <label>Họ và tên của bạn</label>
            <input type="text" name="FullName" class="form-input" required placeholder="Nguyễn Văn A" />
          </div>
          <div class="form-field">
            <label>Số điện thoại</label>
            <input type="tel" name="Phone" class="form-input" required placeholder="09xxxxxxxx" />
          </div>
        </div>
        <div class="form-field">
          <label>Nội dung cần hỗ trợ</label>
          <textarea name="Content" rows="4" class="form-input" required placeholder="Nhập câu hỏi hoặc sự cố bạn cần giải quyết..."></textarea>
        </div>
        <button type="submit" class="btn-primary" style="padding:14px 28px;font-size:15px;font-weight:700;">Gửi Yêu Cầu Hỗ Trợ</button>
      </form>
    </div>
  </div>
</div>
