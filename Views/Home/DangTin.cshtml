@{
    ViewData["Title"] = "Đăng Tin Phòng Trọ | TroTot.vn";
    ViewData["Description"] = "Đăng tin phòng trọ miễn phí, tiếp cận hàng nghìn người thuê tại TP.HCM.";
    ViewData["Icon"] = "🏠";
    ViewData["Active"] = "dangtin";
    ViewData["NavScrolled"] = false;
}

<!-- NAVBAR -->


<div style="padding-top:88px;padding-bottom:60px;background:linear-gradient(180deg,#090d1a 0%,#0f172a 100%);min-height:100vh;">
  <div class="container" style="max-width:860px;">
    <a class="post-home-link" href="/">← Về trang chủ</a>

    <form id="postForm" asp-controller="Home" asp-action="DangTin" method="post" enctype="multipart/form-data" onsubmit="return validatePost()">

    <!-- Progress Steps -->
    <div class="post-steps">
      <div class="post-step active" id="step1Indicator">
        <div class="step-num">1</div>
        <div class="step-text">Thông tin cơ bản</div>
      </div>
      <div class="step-line"></div>
      <div class="post-step" id="step2Indicator">
        <div class="step-num">2</div>
        <div class="step-text">Hình ảnh & Vị trí</div>
      </div>
      <div class="step-line"></div>
      <div class="post-step" id="step3Indicator">
        <div class="step-num">3</div>
        <div class="step-text">Tiện nghi & Giá</div>
      </div>
      <div class="step-line"></div>
      <div class="post-step" id="step4Indicator">
        <div class="step-num">4</div>
        <div class="step-text">Xem trước & Đăng</div>
      </div>
    </div>

    <!-- Step 1: Basic Info -->
    <div id="postStep1" class="post-step-content">
      <div class="post-card">
        <h2 class="post-card-title">📝 Thông Tin Cơ Bản</h2>
        <div style="display:flex;flex-direction:column;gap:18px;">
          <div class="form-field">
            <label>Tiêu đề tin đăng *</label>
            <input type="text" id="postTitle" name="Title" placeholder="VD: Phòng trọ máy lạnh gác lửng, gần ĐH Bách Khoa" class="form-input" />
            <div style="font-size:12px;color:#64748b;margin-top:4px;">Tiêu đề hấp dẫn giúp bài đăng được tìm thấy nhiều hơn</div>
          </div>
          <div class="form-row">
            <div class="form-field">
              <label>Loại phòng *</label>
              <select id="postType" name="RoomType" class="form-input">
                <option value="">Chọn loại phòng...</option>
                <option value="single">Phòng đơn</option>
                <option value="shared">Ở ghép</option>
                <option value="mini">Căn hộ mini</option>
              </select>
            </div>
            <div class="form-field">
              <label>Diện tích (m²) *</label>
              <input type="number" id="postArea" name="Area" placeholder="VD: 20" class="form-input" />
            </div>
          </div>
          <div class="form-field">
            <label>Địa chỉ đầy đủ *</label>
            <input type="text" id="postAddress" name="Address" placeholder="Số nhà, tên đường, phường/xã" class="form-input" />
          </div>
          <div class="form-row">
            <div class="form-field">
              <label>Quận/Huyện *</label>
              <select id="postDistrict" name="District" class="form-input">
                <option value="">Chọn quận...</option>
                <option>Cầu Giấy</option><option>Đống Đa</option><option>Thanh Xuân</option>
                <option>Hai Bà Trưng</option><option>Nam Từ Liêm</option><option>Hà Đông</option>
                <option>Bắc Từ Liêm</option><option>Ba Đình</option><option>Hoàng Mai</option><option>Tây Hồ</option>
              </select>
            </div>
            <div class="form-field">
              <label>Thành phố</label>
              <input type="text" value="TP. Hà Nội" readonly class="form-input" style="opacity:0.6;" />
            </div>
          </div>
          <div class="form-field">
            <label>Mô tả chi tiết</label>
            <textarea id="postDesc" name="Description" rows="5" placeholder="Mô tả về phòng, nội quy, đặc điểm nổi bật, thông tin khu vực xung quanh..." class="form-input form-textarea"></textarea>
          </div>
          <div class="form-field">
            <label>Nội quy phòng trọ</label>
            <textarea id="postRules" name="Rules" rows="3" placeholder="VD: Không hút thuốc, không ồn ào sau 22h, không nấu ăn trong phòng..." class="form-input form-textarea"></textarea>
          </div>
        </div>
        <div style="display:flex;justify-content:flex-end;margin-top:24px;">
          <button type="button" class="btn-primary" onclick="nextStep(2)">Tiếp theo →</button>
        </div>
      </div>
    </div>

    <!-- Step 2: Images & Location -->
    <div id="postStep2" class="post-step-content" style="display:none;">
      <div class="post-card">
        <h2 class="post-card-title">📸 Hình Ảnh & Vị Trí</h2>

        <!-- Image Upload -->
        <div class="image-upload-area" id="imageUploadArea" onclick="document.getElementById('imageInput').click()">
          <div class="upload-icon">📷</div>
          <div class="upload-title">Tải lên hình ảnh</div>
          <div class="upload-sub">Kéo thả hoặc click để chọn ảnh (tối đa 10 ảnh, JPG/PNG, mỗi ảnh tối đa 5MB)</div>
          <input type="file" id="imageInput" name="Images" multiple accept="image/*" style="display:none;" onchange="previewImages(event)" />
        </div>
        <div id="imagePreview" style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;"></div>

        <!-- Video Upload -->
        <div style="margin-top:20px;">
          <label class="form-field" style="display:block;">
            <label>Video giới thiệu (tùy chọn)</label>
            <div class="image-upload-area" style="padding:24px;" onclick="document.getElementById('videoInput').click()">
              <div style="font-size:28px;">🎥</div>
              <div style="font-size:14px;font-weight:600;margin:6px 0;">Tải video lên (tối đa 50MB, MP4/MOV)</div>
              <div style="font-size:12px;color:#64748b;">Hoặc nhập link YouTube/Google Drive</div>
              <input type="file" id="videoInput" accept="video/*" style="display:none;" />
            </div>
          </label>
          <input type="url" id="videoUrl" name="VideoUrl" placeholder="Hoặc nhập link video: https://youtube.com/..." class="form-input" style="margin-top:10px;" />
        </div>

        <!-- Map placeholder -->
        <div style="margin-top:24px;">
          <label style="display:block;font-size:13px;font-weight:700;color:#94a3b8;margin-bottom:10px;text-transform:uppercase;letter-spacing:0.5px;">Chọn vị trí trên bản đồ</label>
          <div id="mapPlaceholder" style="width:100%;height:280px;background:linear-gradient(145deg,#111827,#1a2235);border:1px solid rgba(255,255,255,0.08);border-radius:16px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;cursor:pointer;" onclick="openMapPicker()">
            <div style="font-size:40px;">🗺️</div>
            <div style="font-weight:700;font-size:15px;">Chọn vị trí trên bản đồ</div>
            <div style="font-size:13px;color:#64748b;">Click để mở Google Maps và pin vị trí phòng</div>
            <button type="button" class="btn-outline-primary" style="margin-top:8px;" onclick="event.stopPropagation();openMapPicker()">📍 Chọn vị trí</button>
          </div>
          <div id="mapCoords" style="display:none;font-size:13px;color:#22c55e;margin-top:8px;"></div>
        </div>

        <div style="display:flex;justify-content:space-between;margin-top:24px;">
          <button type="button" class="btn-ghost" onclick="nextStep(1)">← Quay lại</button>
          <button type="button" class="btn-primary" onclick="nextStep(3)">Tiếp theo →</button>
        </div>
      </div>
    </div>

    <!-- Step 3: Amenities & Pricing -->
    <div id="postStep3" class="post-step-content" style="display:none;">
      <div class="post-card">
        <h2 class="post-card-title">💰 Tiện Nghi & Giá Cả</h2>

        <!-- Amenities -->
        <div style="margin-bottom:24px;">
          <label style="display:block;font-size:13px;font-weight:700;color:#94a3b8;margin-bottom:12px;text-transform:uppercase;letter-spacing:0.5px;">Tiện nghi có sẵn</label>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px;">
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Máy lạnh" /><span>❄️ Máy lạnh</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Wifi" /><span>📶 Wifi</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Gác lửng" /><span>🪜 Gác lửng</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Chỗ để xe" /><span>🛵 Chỗ để xe</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Giờ giấc tự do" /><span>🕐 Tự do giờ giấc</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Nuôi thú cưng" /><span>🐾 Nuôi thú cưng</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Bếp nấu ăn" /><span>🍳 Bếp nấu ăn</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Ban công" /><span>🌿 Ban công</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Máy giặt" /><span>👕 Máy giặt chung</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Tủ lạnh" /><span>🧊 Tủ lạnh</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Camera an ninh" /><span>📹 Camera an ninh</span></label>
            <label class="amenity-post-check"><input type="checkbox" name="Amenities" value="Thang máy" /><span>🛗 Thang máy</span></label>
          </div>
        </div>

        <!-- Pricing -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
          <div class="form-field">
            <label>Giá thuê (đ/tháng) *</label>
            <input type="number" id="postPrice" name="Price" placeholder="VD: 3500000" class="form-input" step="100000" />
          </div>
          <div class="form-field">
            <label>Tiền cọc (số tháng) *</label>
            <select id="postDeposit" name="DepositMonths" class="form-input">
              <option value="1">1 tháng</option>
              <option value="2" selected>2 tháng</option>
              <option value="3">3 tháng</option>
            </select>
          </div>
          <div class="form-field">
            <label>Giá điện (đ/kWh)</label>
            <input type="number" id="postElec" name="ElectricPrice" value="3500" class="form-input" />
          </div>
          <div class="form-field">
            <label>Tiền nước (đ/người/tháng)</label>
            <input type="number" id="postWater" name="WaterPrice" value="80000" class="form-input" step="10000" />
          </div>
          <div class="form-field">
            <label>Phí internet (đ/tháng)</label>
            <input type="number" id="postInternet" name="InternetFee" value="0" class="form-input" step="50000" />
          </div>
          <div class="form-field">
            <label>Phí gửi xe (đ/xe/tháng)</label>
            <input type="number" id="postParking" name="ParkingFee" value="150000" class="form-input" step="50000" />
          </div>
        </div>

        <div style="display:flex;justify-content:space-between;margin-top:8px;">
          <button type="button" class="btn-ghost" onclick="nextStep(2)">← Quay lại</button>
          <button type="button" class="btn-primary" onclick="nextStep(4)">Xem trước →</button>
        </div>
      </div>
    </div>

    <!-- Step 4: Preview & Submit -->
    <div id="postStep4" class="post-step-content" style="display:none;">
      <div class="post-card">
        <h2 class="post-card-title">✅ Xem Trước & Đăng Tin</h2>
        <div id="postPreview" style="margin-bottom:24px;"></div>
        <input type="hidden" id="postPackage" name="Package" value="free" />

        <!-- Package selection -->
        <div style="margin-bottom:24px;">
          <label style="display:block;font-size:13px;font-weight:700;color:#94a3b8;margin-bottom:12px;text-transform:uppercase;letter-spacing:0.5px;">Chọn gói đăng tin</label>
          <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;">
            <div class="package-card selected" onclick="selectPackage(this, 'free')">
              <div class="pkg-name">Miễn phí</div>
              <div class="pkg-price">0 đ</div>
              <div class="pkg-features">
                <div>✓ 30 ngày hiển thị</div>
                <div>✓ 5 hình ảnh</div>
                <div style="color:#64748b;">✗ Ưu tiên tìm kiếm</div>
              </div>
            </div>
            <div class="package-card" onclick="selectPackage(this, 'basic')">
              <div class="pkg-badge">Phổ biến</div>
              <div class="pkg-name">Cơ bản</div>
              <div class="pkg-price">99.000 đ</div>
              <div class="pkg-features">
                <div>✓ 60 ngày hiển thị</div>
                <div>✓ 10 hình ảnh + video</div>
                <div>✓ Ưu tiên tìm kiếm</div>
              </div>
            </div>
            <div class="package-card" onclick="selectPackage(this, 'premium')">
              <div class="pkg-name">Premium</div>
              <div class="pkg-price">199.000 đ</div>
              <div class="pkg-features">
                <div>✓ 90 ngày hiển thị</div>
                <div>✓ Không giới hạn ảnh</div>
                <div>✓ Vị trí #1 kết quả</div>
                <div>✓ Badge "Nổi bật"</div>
              </div>
            </div>
          </div>
        </div>

        <div style="display:flex;justify-content:space-between;">
          <button type="button" class="btn-ghost" onclick="nextStep(3)">← Quay lại</button>
          <button type="submit" class="btn-primary" style="font-size:16px;padding:14px 32px;">
            🚀 Đăng Tin Ngay
          </button>
        </div>
      </div>
    </div>

    </form>
  </div>
</div>

<div class="toast" id="toast" style="display:none;"></div>

<style>
.post-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32px;
  gap: 0;
}
.post-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.step-num {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  color: #64748b;
  transition: all 0.3s;
}
.post-step.active .step-num {
  background: #ff6b35;
  border-color: #ff6b35;
  color: white;
  box-shadow: 0 0 0 4px rgba(255,107,53,0.2);
}
.post-step.done .step-num {
  background: #22c55e;
  border-color: #22c55e;
  color: white;
}
.step-text { font-size: 12px; color: #64748b; font-weight: 600; text-align: center; }
.post-step.active .step-text { color: #ff8c42; }
.step-line {
  flex: 1;
  height: 2px;
  background: rgba(255,255,255,0.08);
  margin: 0 8px;
  margin-bottom: 20px;
  min-width: 40px;
}
.post-card {
  background: linear-gradient(145deg, #111827, #1a2235);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px;
  padding: 32px;
}
.post-card-title { font-size: 20px; font-weight: 700; margin-bottom: 24px; }

.image-upload-area {
  border: 2px dashed rgba(255,107,53,0.3);
  border-radius: 16px;
  padding: 40px 20px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s;
  background: rgba(255,107,53,0.04);
}
.image-upload-area:hover { border-color: rgba(255,107,53,0.6); background: rgba(255,107,53,0.08); }
.upload-icon { font-size: 40px; margin-bottom: 12px; }
.upload-title { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
.upload-sub { font-size: 13px; color: #64748b; }

.amenity-post-check {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s;
  color: #94a3b8;
}
.amenity-post-check:hover { border-color: rgba(255,107,53,0.3); color: #f1f5f9; }
.amenity-post-check input { display: none; }
.amenity-post-check input:checked ~ span {
  color: #ff8c42;
}
.amenity-post-check:has(input:checked) {
  background: rgba(255,107,53,0.10);
  border-color: rgba(255,107,53,0.35);
}

.package-card {
  background: rgba(255,255,255,0.03);
  border: 2px solid rgba(255,255,255,0.08);
  border-radius: 16px;
  padding: 20px;
  cursor: pointer;
  transition: all 0.3s;
  position: relative;
  text-align: center;
}
.package-card:hover { border-color: rgba(255,107,53,0.3); }
.package-card.selected {
  border-color: #ff6b35;
  background: rgba(255,107,53,0.08);
}
.pkg-badge {
  position: absolute;
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  background: #ff6b35;
  color: white;
  padding: 3px 12px;
  border-radius: 9999px;
  font-size: 11px;
  font-weight: 700;
}
.pkg-name { font-size: 16px; font-weight: 700; margin-bottom: 6px; }
.pkg-price { font-size: 20px; font-weight: 900; color: #ff8c42; margin-bottom: 14px; }
.pkg-features { font-size: 12.5px; color: #94a3b8; display: flex; flex-direction: column; gap: 6px; text-align: left; }
</style>

@section Scripts {
<script>
let currentStep = 1;
let selectedImages = [];

function nextStep(step) {
  document.getElementById(`postStep${currentStep}`).style.display = 'none';
  document.getElementById(`step${currentStep}Indicator`).classList.add('done');
  document.getElementById(`step${currentStep}Indicator`).classList.remove('active');

  currentStep = step;
  document.getElementById(`postStep${currentStep}`).style.display = 'block';
  document.getElementById(`step${currentStep}Indicator`).classList.add('active');
  document.getElementById(`step${currentStep}Indicator`).classList.remove('done');

  if (step === 4) generatePreview();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function previewImages(e) {
  const files = [...e.target.files];
  const preview = document.getElementById('imagePreview');
  preview.innerHTML = '';
  files.slice(0, 10).forEach((file, i) => {
    const url = URL.createObjectURL(file);
    const div = document.createElement('div');
    div.style.cssText = 'position:relative;width:100px;height:80px;border-radius:8px;overflow:hidden;border:2px solid rgba(255,255,255,0.1);';
    div.innerHTML = `
      <img src="${url}" style="width:100%;height:100%;object-fit:cover;" />
      ${i === 0 ? '<div style="position:absolute;bottom:0;left:0;right:0;background:rgba(255,107,53,0.8);font-size:10px;font-weight:700;color:white;text-align:center;padding:2px;">Ảnh chính</div>' : ''}
      <button type="button" onclick="this.parentElement.remove()" style="position:absolute;top:3px;right:3px;width:18px;height:18px;border-radius:50%;background:rgba(0,0,0,0.7);color:white;font-size:11px;display:flex;align-items:center;justify-content:center;cursor:pointer;border:none;">✕</button>
    `;
    preview.appendChild(div);
  });
}

function openMapPicker() {
  const addr = document.getElementById('postAddress')?.value || '';
  const query = encodeURIComponent(addr || 'TP Hà Nội');
  window.open(`https://www.google.com/maps/search/${query}`, '_blank');
  document.getElementById('mapCoords').style.display = 'block';
  document.getElementById('mapCoords').textContent = '✓ Đã mở Google Maps – vui lòng copy tọa độ vào đây';
}

function generatePreview() {
  const title = document.getElementById('postTitle')?.value || 'Chưa nhập tiêu đề';
  const price = document.getElementById('postPrice')?.value || 0;
  const area = document.getElementById('postArea')?.value || '';
  const district = document.getElementById('postDistrict')?.value || '';
  const preview = document.getElementById('postPreview');
  if (!preview) return;

  preview.innerHTML = `
    <div style="background:rgba(0,0,0,0.2);border:1px solid rgba(255,255,255,0.08);border-radius:14px;padding:20px;">
      <div style="font-size:18px;font-weight:700;color:#f1f5f9;margin-bottom:8px;">${title}</div>
      <div style="font-size:24px;font-weight:900;background:linear-gradient(135deg,#ff6b35,#ffb347);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:12px;">${parseInt(price).toLocaleString('vi-VN')} đ/tháng</div>
      <div style="display:flex;gap:20px;font-size:13px;color:#94a3b8;">
        <span>📐 ${area} m²</span>
        <span>📍 ${district}</span>
      </div>
    </div>
  `;
}

function selectPackage(el, pkg) {
  document.querySelectorAll('.package-card').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  document.getElementById('postPackage').value = pkg;
}

function validatePost() {
  const v = id => (document.getElementById(id).value || '').trim();
  if (!v('postTitle') || !v('postType') || !v('postArea') || !v('postAddress') || !v('postDistrict')) {
    alert('Vui lòng điền đủ các thông tin bắt buộc ở bước 1 (tiêu đề, loại phòng, diện tích, địa chỉ, quận).');
    nextStep(1);
    return false;
  }
  if (!v('postPrice')) {
    alert('Vui lòng nhập giá thuê ở bước 3.');
    nextStep(3);
    return false;
  }
  return true;
}

function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + type;
  toast.style.display = 'block';
  setTimeout(() => { toast.style.display = 'none'; }, 4000);
}
</script>
}
