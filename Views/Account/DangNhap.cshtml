@model TroTot.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập | TroTot.vn";
    ViewData["Description"] = "";
    ViewData["Icon"] = "🏠";
    Layout = "_AuthLayout";
}

<div class="form-page-container">
  <a class="auth-home-link" href="/">← Về trang chủ</a>
  <div class="form-page-card">
    <div style="text-align:center;margin-bottom:24px;">
      <a href="/" style="display:inline-flex;align-items:center;gap:8px;font-size:24px;font-weight:900;color:#f1f5f9;text-decoration:none;">
        <span>🏠</span> TroTot<span style="color:#ff6b35;">.vn</span>
      </a>
    </div>

    <h1 class="form-page-title">Đăng Nhập</h1>
    <p class="form-page-sub">Chào mừng bạn quay trở lại!</p>

    <partial name="_ValidationBox" />

    <div class="social-login-btns">
      <button class="social-login-btn" onclick="socialLogin('google')">
        <svg viewBox="0 0 24 24" fill="none"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Google
      </button>
      <button class="social-login-btn" onclick="socialLogin('facebook')">
        <svg viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </button>
    </div>

    <div class="form-divider"><span>hoặc đăng nhập với email</span></div>

    <form id="loginForm" asp-controller="Account" asp-action="DangNhap" method="post" style="display:flex;flex-direction:column;gap:14px;">
      <input type="hidden" name="ReturnUrl" value="@Model?.ReturnUrl" />
      <div class="form-field">
        <label>Email hoặc số điện thoại</label>
        <input type="text" id="loginId" name="LoginId" value="@Model?.LoginId" placeholder="email@@example.com hoặc 09xxxxxxxx" required class="form-input" />
      </div>
      <div class="form-field">
        <label>Mật khẩu</label>
        <div style="position:relative;">
          <input type="password" id="loginPass" name="Password" placeholder="Mật khẩu của bạn" required class="form-input" style="padding-right:44px;" />
          <button type="button" onclick="togglePass()" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);color:#64748b;font-size:16px;background:none;border:none;cursor:pointer;">👁</button>
        </div>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;font-size:13px;">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;color:#94a3b8;">
          <input type="checkbox" name="RememberMe" value="true" style="accent-color:#ff6b35;" /> Nhớ tôi
        </label>
        <a href="/quen-mat-khau" style="color:#ff8c42;font-weight:600;">Quên mật khẩu?</a>
      </div>
      <button type="submit" class="btn-primary w-full" style="justify-content:center;font-size:16px;padding:14px;margin-top:4px;">
        Đăng Nhập
      </button>
    </form>

    <div class="form-link-row" style="margin-top:20px;">Chưa có tài khoản? <a href="/dang-ky">Đăng ký ngay</a></div>
  </div>
</div>

<div class="toast" id="toast" style="display:none;"></div>

@section Scripts {
<script>
function togglePass() {
  const input = document.getElementById('loginPass');
  input.type = input.type === 'password' ? 'text' : 'password';
}

function socialLogin(provider) {
  showToast(`🔗 Đang kết nối với ${provider === 'google' ? 'Google' : 'Facebook'}...`, 'success');
  setTimeout(() => window.location.href = '/', 1500);
}

function showToast(msg, type = 'success') {
  const toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + type;
  toast.style.display = 'block';
  setTimeout(() => { toast.style.display = 'none'; }, 3500);
}
</script>
}
