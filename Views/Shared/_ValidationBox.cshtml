@if (!ViewData.ModelState.IsValid)
{
    <div style="background:rgba(239,68,68,0.10);border:1px solid rgba(239,68,68,0.4);color:#fca5a5;border-radius:10px;padding:12px 16px;font-size:13px;line-height:1.6;margin-bottom:16px;">
        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
        {
            <div>• @err</div>
        }
    </div>
}
